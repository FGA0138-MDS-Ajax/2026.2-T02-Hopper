@startuml
!include estilo.iuml
node "Dispositivo do usuário\n(celular ou computador)" as Disp {
  node "Navegador web" as Nav {
    artifact "SPA React\n(HTML, CSS, JS)" as SPA
  }
}
node "GitHub" as GH {
  artifact "Repositório\n(main, developer, docs)" as Repo
  artifact "GitHub Pages\n(MkDocs)" as Pages
}
cloud "Render" as RenderNuvem {
  node "Static Site (CDN)" as Static {
    artifact "Build estático\ndo front-end" as Build
  }
  node "Web Service" as Web {
    node "Contêiner Docker\nNode.js 20" as Docker {
      artifact "API REST\n(Express)" as API
    }
  }
}
database "Neon - PostgreSQL\ngerenciado" as Neon
cloud "Brevo\n(API HTTP de e-mail)" as Brevo
Nav --> Build : HTTPS
Nav --> API : HTTPS / JSON
API --> Neon : TLS (5432)
API --> Brevo : HTTPS\n(recuperação de senha)
Repo ..> RenderNuvem : publicação\n(main)
@enduml
