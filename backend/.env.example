NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://aulacerta:aulacerta@localhost:5432/aulacerta?schema=public
# Banco SÓ dos testes de integração (npm run test:integration): eles apagam tudo o que houver nele.
# Precisa ser outro banco, nunca o mesmo do DATABASE_URL. Pode ser o banco-teste do docker-compose
# ou um banco separado no Neon (ex.: aulacerta_teste); veja tests/helpers/banco-de-teste.ts.
DATABASE_URL_TESTE=postgresql://aulacerta:aulacerta@localhost:5433/aulacerta_teste?schema=public
JWT_SECRET=troque-por-um-segredo-com-mais-de-32-caracteres
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173
# E-mail de recuperação de senha (Brevo): crie a chave em Brevo > SMTP & API > API Keys.
# O remetente precisa estar verificado no Brevo (Senders, Domains & Dedicated IPs).
# Sem chave, fora de produção, o link de redefinição aparece no terminal.
BREVO_API_KEY=
EMAIL_REMETENTE=nao-responda@aulacerta.com.br
EMAIL_REMETENTE_NOME=AulaCerta
FRONTEND_URL=http://localhost:5173
SEED_ADMIN_EMAIL=admin@aulacerta.com.br
SEED_SENHA=Senha@12345
